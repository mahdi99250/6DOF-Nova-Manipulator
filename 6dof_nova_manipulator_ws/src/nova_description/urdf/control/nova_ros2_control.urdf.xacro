<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="nova_ros2_control_joint" params="name config">
        <joint name="${name}">
            <command_interface name="position">
                <param name="min">${config['limit']['lower']}</param>
                <param name="max">${config['limit']['upper']}</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="nova_ros2_control" params="prefix flange_link use_gazebo">
        <xacro:property name="control_joint_props" value="${xacro.load_yaml('$(find nova_description)/urdf/properties/joint_properties.yaml')}"/>
        <ros2_control name="${prefix}RobotSystem" type="system">
            <hardware>
                <xacro:if value="${use_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
            </hardware>

            <xacro:nova_ros2_control_joint name="${prefix}joint1" config="${control_joint_props['joint1']}"/>
            <xacro:nova_ros2_control_joint name="${prefix}joint2" config="${control_joint_props['joint2']}"/>
            <xacro:nova_ros2_control_joint name="${prefix}joint3" config="${control_joint_props['joint3']}"/>
            <xacro:nova_ros2_control_joint name="${prefix}joint4" config="${control_joint_props['joint4']}"/>
            <xacro:nova_ros2_control_joint name="${prefix}joint5" config="${control_joint_props['joint5']}"/>
            <xacro:nova_ros2_control_joint name="${prefix}joint6" config="${control_joint_props['joint6']}"/>

        </ros2_control>
    </xacro:macro>

</robot>
