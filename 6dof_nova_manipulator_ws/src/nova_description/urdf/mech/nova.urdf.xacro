<?xml version="1.0"?>
<robot name="$(arg robot_name)"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="robot_name" default="nova"/>
    <xacro:arg name="add_world" default="true"/>
    <xacro:arg name="base_link" default=""/>
    <xacro:arg name="base_type" default="g_shape"/>
    <xacro:arg name="flange_link" default=""/>
    <xacro:arg name="use_camera" default="false"/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="controllers_file" default="$(find nova_moveit_config)/config/nova/ros2_controllers.yaml"/>
    <!-- <xacro:arg name="use_gripper" default="false"/> -->

    <xacro:property name="prefix" value="$(arg robot_name)_"/>
    <xacro:property name="resolved_base_link" value="${'$(arg base_link)' if '$(arg base_link)' != '' else prefix + 'base_link'}"/>
    <xacro:property name="resolved_flange_link" value="${'$(arg flange_link)' if '$(arg flange_link)' != '' else prefix + 'end_link'}"/>

    <xacro:include filename="$(find nova_description)/urdf/mech/materials.xacro" />
    <xacro:include filename="$(find nova_description)/urdf/mech/macros.xacro" />

    <xacro:property name="link_props" value="${xacro.load_yaml('$(find nova_description)/urdf/properties/link_properties.yaml')}"/>

    <xacro:property name="base_config" value="${link_props['base']}"/>
    <xacro:property name="link1_config" value="${link_props['link1']}"/>
    <xacro:property name="link2_config" value="${link_props['link2']}"/>
    <xacro:property name="link3_config" value="${link_props['link3']}"/>
    <xacro:property name="link4_config" value="${link_props['link4']}"/>
    <xacro:property name="link5_config" value="${link_props['link5']}"/>
    <xacro:property name="link6_config" value="${link_props['link6']}"/>

    <xacro:property name="joint_props" value="${xacro.load_yaml('$(find nova_description)/urdf/properties/joint_properties.yaml')}"/>

    <xacro:property name="joint1_config" value="${joint_props['joint1']}"/>
    <xacro:property name="joint2_config" value="${joint_props['joint2']}"/>
    <xacro:property name="joint3_config" value="${joint_props['joint3']}"/>
    <xacro:property name="joint4_config" value="${joint_props['joint4']}"/>
    <xacro:property name="joint5_config" value="${joint_props['joint5']}"/>
    <xacro:property name="joint6_config" value="${joint_props['joint6']}"/>

    <xacro:property name="PI" value="3.1415926535897931"/>
    <xacro:property name="density" value="3.09"/>

    <xacro:if value="$(arg add_world)">
        <link name="world"/>

        <joint name="${prefix}world_base" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 -1.5708" />
            <parent link="world" />
            <child link="${resolved_base_link}" />
        </joint>
    </xacro:if>

    <link name="${resolved_base_link}"/>

    <joint name="${prefix}base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 ${PI/2}" />
        <parent link="${resolved_base_link}" />
        <child link="${prefix}base" />
    </joint>

    <link name="${prefix}base">
        <inertial>
            <origin xyz="${base_config['origin']['x']} ${base_config['origin']['y']} ${base_config['origin']['z']}" rpy="${base_config['origin']['roll']} ${base_config['origin']['pitch']} ${base_config['origin']['yaw']}" />
            <mass value="${base_config['mass']}"/>
            <inertia ixx="${base_config['inertia']['ixx']}" ixy="${base_config['inertia']['ixy']}" ixz="${base_config['inertia']['ixz']}" iyy="${base_config['inertia']['iyy']}" iyz="${base_config['inertia']['iyz']}" izz="${base_config['inertia']['izz']}"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_base.STL" />
            </geometry>
            <material name="">
                <color rgba="0.866666666666667 0.866666666666667 0.890196078431372 1" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_base.STL" />
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link1">
        <inertial>
            <origin xyz="${link1_config['origin']['x']} ${link1_config['origin']['y']} ${link1_config['origin']['z']}" rpy="${link1_config['origin']['roll']} ${link1_config['origin']['pitch']} ${link1_config['origin']['yaw']}" />
            <mass value="${link1_config['mass']}" />
            <inertia ixx="${link1_config['inertia']['ixx']}" ixy="${link1_config['inertia']['ixy']}" ixz="${link1_config['inertia']['ixz']}" iyy="${link1_config['inertia']['iyy']}" iyz="${link1_config['inertia']['iyz']}" izz="${link1_config['inertia']['izz']}" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link1.STL" />
            </geometry>
            <material name="">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link1.STL" />
            </geometry>
        </collision>
    </link>

    <xacro:joint name="${prefix}joint1" parent="${prefix}base" child="${prefix}link1">
        <origin xyz="${joint1_config['origin']['x']} ${joint1_config['origin']['y']} ${joint1_config['origin']['z']}" rpy="${joint1_config['origin']['roll']} ${joint1_config['origin']['pitch']} ${joint1_config['origin']['yaw']}" />
        <limit lower="${joint1_config['limit']['lower']}" upper="${joint1_config['limit']['upper']}" effort="${joint1_config['limit']['effort']}" velocity="${joint1_config['limit']['velocity']}"/>
    </xacro:joint>

    <link name="${prefix}link2">
        <inertial>
            <origin xyz="${link2_config['origin']['x']} ${link2_config['origin']['y']} ${link2_config['origin']['z']}" rpy="${link2_config['origin']['roll']} ${link2_config['origin']['pitch']} ${link2_config['origin']['yaw']}" />
            <mass value="${link2_config['mass']}" />
            <inertia ixx="${link2_config['inertia']['ixx']}" ixy="${link2_config['inertia']['ixy']}" ixz="${link2_config['inertia']['ixz']}" iyy="${link2_config['inertia']['iyy']}" iyz="${link2_config['inertia']['iyz']}" izz="${link2_config['inertia']['izz']}" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link2.STL" />
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link2.STL" />
            </geometry>
        </collision>
    </link>

    <xacro:joint name="${prefix}joint2" parent="${prefix}link1" child="${prefix}link2">
        <origin xyz="${joint2_config['origin']['x']} ${joint2_config['origin']['y']} ${joint2_config['origin']['z']}" rpy="${joint2_config['origin']['roll']} ${joint2_config['origin']['pitch']} ${joint2_config['origin']['yaw']}" />
        <limit lower="${joint2_config['limit']['lower']}" upper="${joint2_config['limit']['upper']}" effort="${joint2_config['limit']['effort']}" velocity="${joint2_config['limit']['velocity']}"/>
    </xacro:joint>

    <link name="${prefix}link3">
        <inertial>
            <origin xyz="${link3_config['origin']['x']} ${link3_config['origin']['y']} ${link3_config['origin']['z']}" rpy="${link3_config['origin']['roll']} ${link3_config['origin']['pitch']} ${link3_config['origin']['yaw']}" />
            <mass value="${link3_config['mass']}" />
            <inertia ixx="${link3_config['inertia']['ixx']}" ixy="${link3_config['inertia']['ixy']}" ixz="${link3_config['inertia']['ixz']}" iyy="${link3_config['inertia']['iyy']}" iyz="${link3_config['inertia']['iyz']}" izz="${link3_config['inertia']['izz']}" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link3.STL" />
            </geometry>
            <material name="">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link3.STL" />
            </geometry>
        </collision>
    </link>

    <xacro:joint name="${prefix}joint3" parent="${prefix}link2" child="${prefix}link3">
        <origin xyz="${joint3_config['origin']['x']} ${joint3_config['origin']['y']} ${joint3_config['origin']['z']}" rpy="${joint3_config['origin']['roll']} ${joint3_config['origin']['pitch']} ${joint3_config['origin']['yaw']}" />
        <limit lower="${joint3_config['limit']['lower']}" upper="${joint3_config['limit']['upper']}" effort="${joint3_config['limit']['effort']}" velocity="${joint3_config['limit']['velocity']}"/>
    </xacro:joint>

    <link name="${prefix}link4">
        <inertial>
            <origin xyz="${link4_config['origin']['x']} ${link4_config['origin']['y']} ${link4_config['origin']['z']}" rpy="${link4_config['origin']['roll']} ${link4_config['origin']['pitch']} ${link4_config['origin']['yaw']}" />
            <mass value="${link4_config['mass']}" />
            <inertia ixx="${link4_config['inertia']['ixx']}" ixy="${link4_config['inertia']['ixy']}" ixz="${link4_config['inertia']['ixz']}" iyy="${link4_config['inertia']['iyy']}" iyz="${link4_config['inertia']['iyz']}" izz="${link4_config['inertia']['izz']}" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link4.STL" />
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link4.STL" />
            </geometry>
        </collision>
    </link>

    <xacro:joint name="${prefix}joint4" parent="${prefix}link3" child="${prefix}link4">
        <origin xyz="${joint4_config['origin']['x']} ${joint4_config['origin']['y']} ${joint4_config['origin']['z']}" rpy="${joint4_config['origin']['roll']} ${joint4_config['origin']['pitch']} ${joint4_config['origin']['yaw']}" />
        <limit lower="${joint4_config['limit']['lower']}" upper="${joint4_config['limit']['upper']}" effort="${joint4_config['limit']['effort']}" velocity="${joint4_config['limit']['velocity']}"/>
    </xacro:joint>

    <link name="${prefix}link5">
        <inertial>
            <origin xyz="${link5_config['origin']['x']} ${link5_config['origin']['y']} ${link5_config['origin']['z']}" rpy="${link5_config['origin']['roll']} ${link5_config['origin']['pitch']} ${link5_config['origin']['yaw']}" />
            <mass value="${link5_config['mass']}" />
            <inertia ixx="${link5_config['inertia']['ixx']}" ixy="${link5_config['inertia']['ixy']}" ixz="${link5_config['inertia']['ixz']}" iyy="${link5_config['inertia']['iyy']}" iyz="${link5_config['inertia']['iyz']}" izz="${link5_config['inertia']['izz']}" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link5.STL" />
            </geometry>
            <material name="">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link5.STL" />
            </geometry>
        </collision>
    </link>

    <xacro:joint name="${prefix}joint5" parent="${prefix}link4" child="${prefix}link5">
        <origin xyz="${joint5_config['origin']['x']} ${joint5_config['origin']['y']} ${joint5_config['origin']['z']}" rpy="${joint5_config['origin']['roll']} ${joint5_config['origin']['pitch']} ${joint5_config['origin']['yaw']}" />
        <limit lower="${joint5_config['limit']['lower']}" upper="${joint5_config['limit']['upper']}" effort="${joint5_config['limit']['effort']}" velocity="${joint5_config['limit']['velocity']}"/>
    </xacro:joint>

    <link name="${prefix}link6">
        <inertial>
            <origin xyz="${link6_config['origin']['x']} ${link6_config['origin']['y']} ${link6_config['origin']['z']}" rpy="${link6_config['origin']['roll']} ${link6_config['origin']['pitch']} ${link6_config['origin']['yaw']}" />
            <mass value="${link6_config['mass']}" />
            <inertia ixx="${link6_config['inertia']['ixx']}" ixy="${link6_config['inertia']['ixy']}" ixz="${link6_config['inertia']['ixz']}" iyy="${link6_config['inertia']['iyy']}" iyz="${link6_config['inertia']['iyz']}" izz="${link6_config['inertia']['izz']}" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link6.STL" />
            </geometry>
            <material name="">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nova_description/meshes/visual/nova/nova_link6.STL" />
            </geometry>
        </collision>
    </link>

    <xacro:joint name="${prefix}joint6" parent="${prefix}link5" child="${prefix}link6">
        <origin xyz="${joint6_config['origin']['x']} ${joint6_config['origin']['y']} ${joint6_config['origin']['z']}" rpy="${joint6_config['origin']['roll']} ${joint6_config['origin']['pitch']} ${joint6_config['origin']['yaw']}" />
        <limit lower="${joint6_config['limit']['lower']}" upper="${joint6_config['limit']['upper']}" effort="${joint6_config['limit']['effort']}" velocity="${joint6_config['limit']['velocity']}"/>
    </xacro:joint>

    <link name="${resolved_flange_link}"></link>

    <joint name="${prefix}end_joint" type="fixed">
        <origin xyz="0 0 0.155" rpy="0 0 0" />
        <parent link="${prefix}link6" />
        <child link="${resolved_flange_link}" />
        <axis xyz="0 0 0" />
    </joint>

    <!-- <link name="${prefix}dummy_gripper"/>

    <joint name="${prefix}dummy_joint" type="fixed">
        <origin xyz="0 -0.111 0" rpy="${PI/2} ${-PI/2} 0" />
        <parent link="${prefix}link6" />
        <child link="${prefix}dummy_gripper" />
    </joint> -->

    <xacro:include filename="$(find nova_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro"/>
    <xacro:load_gazebo_sim_ros2_control_plugin robot_name="$(arg robot_name)" use_gazebo="$(arg use_gazebo)" controllers_file="$(arg controllers_file)" />

    <xacro:include filename="$(find nova_description)/urdf/control/nova_ros2_control.urdf.xacro"/>
    <xacro:nova_ros2_control prefix="${prefix}" flange_link="${resolved_flange_link}" use_gazebo="$(arg use_gazebo)" />


</robot>